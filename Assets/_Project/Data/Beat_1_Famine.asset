  m_Name: Beat_1_Famine
  m_EditorClassIdentifier: Assembly-CSharp::Itan.Story.StoryBeat
  beatNumber: 1
  title: The Famine
  narration:
  - clip: {fileID: 8300000, guid: e8beb7a9b466f4c13ab66c7b751ccc27, type: 3}
    subtitle: Long ago, a great famine came to the land. Every pot was empty, and
      every field was dry.
    spokenText: 
  - clip: {fileID: 8300000, guid: 8cc63562d90f0451a8be89bd25ceb3b5, type: 3}
    subtitle: "But Aj\xE1 the dog never looked hungry. Each night he slipped away
      to a quiet place, and sang a secret song to his mother in the sky."
    spokenText: But the dog never looked hungry. Each night he slipped away to a
      quiet place, and sang a secret song to his mother in the sky.
  afterMoment:
  - clip: {fileID: 8300000, guid: b1dff16e3986347aeb2c342d1e11437c, type: 3}
    subtitle: And down from the clouds came a rope.
    spokenText: 
  wordCard: {fileID: 11400000, guid: b6ea64a380cb541f7a788caa28c9bdde, type: 2}
