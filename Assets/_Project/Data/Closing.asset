  m_Script: {fileID: 11500000, guid: 6ef94dcfbe2f47b0ab396aa9375f845e, type: 3}
  m_Name: Closing
  m_EditorClassIdentifier: Assembly-CSharp::Itan.Story.ClosingScript
  quizIntro:
    clip: {fileID: 8300000, guid: 20ca0fbceb70b476e9bad8840556e0b7, type: 3}
    subtitle: Now, let us see what is in your calabash. Listen to each word, and
      choose the card that matches.
    spokenText: 
  lesson:
    clip: {fileID: 8300000, guid: e006883add50f4f18838671772727e72, type: 3}
    subtitle: "And that, my child, is why \xCCj\xE0p\xE1's shell is cracked to this
      day. Being curious is good, but taking what is not yours will always let you
      fall."
    spokenText: And that, my child, is why Ee-jah-pah's shell is cracked to this
      day. Being curious is good, but taking what is not yours will always let you
      fall.
  farewell:
    clip: {fileID: 8300000, guid: 795784703171643429fad9681f01b60d, type: 3}
    subtitle: "You carry three new words home tonight: aj\xE1, \xECy\xE1 and \xECj\xE0p\xE1.
      \xD3 d\xE0b\u1ECD\u0300, go well."
    spokenText: 'You carry three new words home tonight: ah-jah, ee-yah, and ee-jah-pah.
      Oh dah-baw, go well.'
