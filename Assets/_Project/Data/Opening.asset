  welcome:
    clip: {fileID: 8300000, guid: 7b7bd576c6ffc463a94261a7dc17bd8b, type: 3}
    subtitle: Welcome, my child. Come, sit by the fire with us.
  bowPrompt:
    clip: {fileID: 8300000, guid: e6e286d827fbc4f30a4eca3dc15b41dc, type: 3}
    subtitle: Before a story is told, we greet our elders. Bow your head to greet
      me.
  calabashPrompt:
    clip: {fileID: 8300000, guid: 906a677629dc145d0b06928c3e308c0c, type: 3}
    subtitle: Good. Now take this calabash. It will hold the words you learn tonight.
